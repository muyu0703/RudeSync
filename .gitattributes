# Normalise line endings so the repo is identical for every contributor.
# Without this, Windows checkouts produce CRLF diffs on files authored on other
# platforms (and vice versa).
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.db binary
*.exe binary
*.dll binary
