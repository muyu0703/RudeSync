{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RudeSync",
  "version": "0.1.2",
  "identifier": "com.rudesync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RudeSync",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": true,
        "resizable": true,
        "decorations": true,
        "windowEffects": {
          "effects": ["mica", "underWindowBackground"],
          "state": "active"
        }
      },
      {
        "label": "task-widget",
        "url": "widget.html",
        "title": "RudeSync Tasks",
        "width": 300,
        "height": 420,
        "minWidth": 200,
        "minHeight": 160,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "category": "Productivity",
    "shortDescription": "Personal work, invoice, task, and loan tracking.",
    "longDescription": "RudeSync is an offline-first personal tracker for tasks, project work, invoices, earnings, and personal loan payment schedules.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
