{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RudeSync CN",
  "version": "0.2.3",
  "identifier": "com.rudesync.desktop.cn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RudeSync 中文定制版",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": true,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "task-widget",
        "url": "widget.html",
        "title": "RudeSync 提醒与待办",
        "width": 300,
        "height": 420,
        "minWidth": 200,
        "minHeight": 160,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "category": "Productivity",
    "shortDescription": "中文本地待办、定时闹钟、倒计时与工作财务管理。",
    "longDescription": "RudeSync CN 是本地优先的中文效率工具，包含待办事项、定时闹钟、倒计时、项目、发票、收入与个人借款管理。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
